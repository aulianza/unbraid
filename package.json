{
  "name": "unbraid",
  "version": "0.11.1",
  "description": "Unbraid a tangled working tree into atomic commits, with AI-written messages.",
  "keywords": [
    "git",
    "commit",
    "ai",
    "conventional-commits",
    "cli",
    "atomic-commits"
  ],
  "homepage": "https://github.com/aulianza/unbraid",
  "bugs": "https://github.com/aulianza/unbraid/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aulianza/unbraid.git"
  },
  "license": "MIT",
  "author": "aulianza (https://aulianza.com)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "unbraid": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ink": "^7.1.1",
    "picomatch": "^4.0.5",
    "react": "^19.2.8",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "workspaces": [
    "extension"
  ]
}
